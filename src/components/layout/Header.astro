---
import { getLocalizedPath, stripLocale, t, type Locale } from "../../i18n";
import ThemeToggle from "./ThemeToggle.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const currentPath = stripLocale(Astro.url.pathname);

const email = t(lang, "hero.email");

const navItems = [
  { href: "/", key: "nav.home" },
  { href: "/about", key: "nav.about" },
  { href: "/projects", key: "nav.projects" },
  { href: "/writings", key: "nav.writings" },
  { href: "/yapping", key: "nav.yapping" },
] as const;

function isActive(href: string) {
  if (href === "/") return currentPath === "/";
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header class="sticky top-0 z-50 bg-(--color-bg)/80 backdrop-blur-md">
  <div
    class="mx-auto flex max-w-6xl items-center justify-between px-5 py-5 md:py-6"
  >
    <a
      href={getLocalizedPath("/", lang)}
      class="flex items-center gap-2 font-display text-xl font-medium text-(--color-text)"
    >
      <span
        class="inline-flex size-7 items-center justify-center rounded-md bg-(--color-accent) text-(--color-accent-foreground) text-sm font-bold"
        >Ir</span
      >
      <span>syaad.dev</span>
    </a>

    <nav class="hidden items-center gap-8 md:flex">
      {
        navItems.map((item) => (
          <a
            href={getLocalizedPath(item.href, lang)}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "relative text-sm font-medium transition-colors",
              isActive(item.href)
                ? "text-(--color-text)"
                : "text-(--color-text-secondary) hover:text-(--color-text)",
            ]}
          >
            {t(lang, item.key)}
            {isActive(item.href) && (
              <span
                aria-hidden="true"
                class="absolute -bottom-2 left-1/2 size-1 -translate-x-1/2 rounded-full bg-(--color-accent)"
              />
            )}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <LanguageSwitcher lang={lang} />
      <ThemeToggle />
      <button
        id="mobile-menu-toggle"
        type="button"
        aria-label="Toggle menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
        class="relative md:hidden inline-flex size-9 items-center justify-center rounded-full border border-(--color-border) bg-(--color-bg) text-(--color-text) z-50"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-4 mobile-toggle-icon-open"
          aria-hidden="true"
        >
          <line x1="4" x2="20" y1="7" y2="7"></line>
          <line x1="4" x2="20" y1="17" y2="17"></line>
        </svg>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-4 mobile-toggle-icon-close absolute"
          aria-hidden="true"
        >
          <path d="M6 6 18 18"></path>
          <path d="M6 18 18 6"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<div
  id="mobile-menu"
  data-open="false"
  role="dialog"
  aria-modal="true"
  aria-label="Main menu"
  aria-hidden="true"
  class="fixed inset-0 z-40 md:hidden bg-(--color-bg) opacity-0 pointer-events-none transition-opacity duration-300 ease-out data-[open=true]:opacity-100 data-[open=true]:pointer-events-auto motion-reduce:duration-150"
>
  <nav class="mx-auto flex h-full max-w-6xl flex-col items-start justify-center gap-6 px-8 pt-24 pb-16">
    {
      navItems.map((item, index) => (
        <a
          href={getLocalizedPath(item.href, lang)}
          aria-current={isActive(item.href) ? "page" : undefined}
          style={`--stagger: ${80 + index * 60}ms`}
          class:list={[
            "mobile-nav-link inline-flex items-center gap-3 font-display text-4xl leading-none transition-colors",
            isActive(item.href)
              ? "text-(--color-text)"
              : "text-(--color-text-secondary) hover:text-(--color-text)",
          ]}
        >
          {isActive(item.href) && (
            <span
              aria-hidden="true"
              class="size-2 shrink-0 rounded-full bg-(--color-accent)"
            />
          )}
          <span>{t(lang, item.key)}</span>
        </a>
      ))
    }
  </nav>
</div>

<script>
  function closeMobileMenu(menu: HTMLElement, toggle: HTMLElement) {
    menu.dataset.open = "false";
    menu.setAttribute("aria-hidden", "true");
    toggle.setAttribute("aria-expanded", "false");
    document.body.classList.remove("overflow-hidden");
  }

  function openMobileMenu(menu: HTMLElement, toggle: HTMLElement) {
    menu.dataset.open = "true";
    menu.setAttribute("aria-hidden", "false");
    toggle.setAttribute("aria-expanded", "true");
    document.body.classList.add("overflow-hidden");
    const first = menu.querySelector<HTMLAnchorElement>("a");
    first?.focus({ preventScroll: true });
  }

  function initMobileMenu() {
    const toggle = document.getElementById("mobile-menu-toggle");
    const menu = document.getElementById("mobile-menu");
    if (!toggle || !menu || toggle.dataset.bound === "true") return;
    toggle.dataset.bound = "true";

    toggle.addEventListener("click", () => {
      const expanded = toggle.getAttribute("aria-expanded") === "true";
      if (expanded) {
        closeMobileMenu(menu, toggle);
        toggle.focus({ preventScroll: true });
      } else {
        openMobileMenu(menu, toggle);
      }
    });

    menu.addEventListener("click", (event) => {
      const target = event.target as HTMLElement | null;
      if (target && target.closest("a")) {
        closeMobileMenu(menu, toggle);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      if (menu.dataset.open !== "true") return;
      closeMobileMenu(menu, toggle);
      toggle.focus({ preventScroll: true });
    });

    document.addEventListener("astro:before-preparation", () => {
      closeMobileMenu(menu, toggle);
    });
  }

  initMobileMenu();
  document.addEventListener("astro:page-load", initMobileMenu);
</script>
