---
import { t, type Locale } from '../../i18n';
import { getExperiences } from '../../lib/experiences';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const items = getExperiences(lang);
---

<section class="mx-auto max-w-6xl px-5 py-16 md:py-24">
  <h2 class="font-display text-4xl md:text-5xl">{t(lang, 'about.experience_title')}</h2>

  <ol class="relative mt-12 ml-3 border-l border-(--color-border)">
    {
      items.map((exp) => (
        <li class="relative pb-14 pl-8 last:pb-0">
          {exp.current && (
            <span
              aria-hidden="true"
              class="pointer-events-none absolute -left-[7px] top-1.5 inline-flex size-3.5 animate-ping rounded-full bg-(--color-accent-underline) opacity-70"
            />
          )}
          <span
            aria-hidden={exp.current ? undefined : 'true'}
            aria-label={exp.current ? 'Current role' : undefined}
            class:list={[
              'absolute -left-[5px] top-2 inline-flex size-2.5 rounded-full ring-4 ring-(--color-bg)',
              exp.current ? 'bg-(--color-accent-underline)' : 'bg-(--color-border)',
            ]}
          />

          <p class="text-xs uppercase tracking-[0.14em] text-(--color-text-secondary)">
            {exp.period}
          </p>
          <h3 class="mt-2 font-display text-2xl leading-snug md:text-3xl">
            {exp.role}
          </h3>
          <div class="mt-1 flex flex-wrap items-center gap-x-1.5 gap-y-1 text-sm text-(--color-text-secondary)">
            {exp.companyLogo && (
              <img
                src={exp.companyLogo}
                alt=""
                aria-hidden="true"
                loading="lazy"
                class:list={[
                  'inline-block size-5 shrink-0 bg-white object-contain p-0.5',
                  exp.companyLogoRounded ? 'rounded-full object-cover p-0' : 'rounded',
                ]}
              />
            )}
            {exp.companyUrl ? (
              <a
                href={exp.companyUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="underline-offset-2 hover:underline"
              >
                {exp.company}
              </a>
            ) : (
              <span>{exp.company}</span>
            )}
            <span class="opacity-60" aria-hidden="true">·</span>
            <span>{exp.location}</span>
          </div>

          {exp.description && (
            <p class="mt-3 text-sm italic text-(--color-text-secondary) md:text-base">
              {exp.description}
            </p>
          )}

          <ul class="mt-5 space-y-2.5 text-sm leading-relaxed text-(--color-text-secondary) md:text-base">
            {exp.bullets.map((bullet) => (
              <li class="flex gap-3">
                <span
                  aria-hidden="true"
                  class="mt-2 inline-block size-1 shrink-0 rounded-full bg-(--color-text-secondary)"
                />
                <span>{bullet}</span>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
</section>
