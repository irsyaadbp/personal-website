---
import { Icon } from 'astro-icon/components';

interface TechItem {
  name: string;
  icon: string;
}

const techs: TechItem[] = [
  { name: 'React', icon: 'simple-icons:react' },
  { name: 'Next.js', icon: 'simple-icons:nextdotjs' },
  { name: 'Vue', icon: 'simple-icons:vuedotjs' },
  { name: 'Nuxt', icon: 'simple-icons:nuxtdotjs' },
  { name: 'Astro', icon: 'simple-icons:astro' },
  { name: 'JavaScript', icon: 'simple-icons:javascript' },
  { name: 'TypeScript', icon: 'simple-icons:typescript' },
  { name: 'PHP', icon: 'simple-icons:php' },
  { name: 'Laravel', icon: 'simple-icons:laravel' },
  { name: 'Node.js', icon: 'simple-icons:nodedotjs' },
  { name: 'TailwindCSS', icon: 'simple-icons:tailwindcss' },
  { name: 'PostgreSQL', icon: 'simple-icons:postgresql' },
  { name: 'MongoDB', icon: 'simple-icons:mongodb' },
  { name: 'Firebase', icon: 'simple-icons:firebase' },
  { name: 'Supabase', icon: 'simple-icons:supabase' },
  { name: 'Docker', icon: 'simple-icons:docker' },
  { name: 'Linux', icon: 'simple-icons:linux' },
  { name: 'Git', icon: 'simple-icons:git' },
  { name: 'GitHub Actions', icon: 'simple-icons:githubactions' },
  { name: 'React Native', icon: 'simple-icons:react' },
];
---

<section class="border-y border-(--color-border) py-10 md:py-14">
  <div class="overflow-hidden">
    <div class="marquee flex w-max items-center gap-12 pr-12 whitespace-nowrap md:gap-16">
      {
        [...techs, ...techs, ...techs].map((item) => (
          <div class="inline-flex items-center gap-3 text-lg font-medium text-(--color-text)">
            <Icon
              name={item.icon}
              class="size-6 shrink-0 text-(--color-text-secondary)"
            />
            <span>{item.name}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>
