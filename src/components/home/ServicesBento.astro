---
import { Icon } from 'astro-icon/components';
import { t, type Locale } from '../../i18n';
import { EMAIL } from '../../lib/socials';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

type CardSize = 'small' | 'wide' | 'tall';

interface Service {
  title: string;
  body: string;
  subject: string;
  size: CardSize;
  featured?: boolean;
  stack?: { icon: string; label: string }[];
}

const services: Record<Locale, Service[]> = {
  en: [
    {
      title: 'Full-stack Development',
      body: 'Typed APIs and modern frontends — from schema to ship.',
      subject: 'Full-stack Development inquiry',
      size: 'wide',
      stack: [
        { icon: 'simple-icons:laravel', label: 'Laravel' },
        { icon: 'simple-icons:hono', label: 'Hono' },
        { icon: 'simple-icons:postgresql', label: 'PostgreSQL' },
        { icon: 'simple-icons:typescript', label: 'TypeScript' },
        { icon: 'simple-icons:wordpress', label: 'WordPress' },
      ],
    },
    {
      title: 'Frontend Engineering',
      body: 'Pixel-perfect, accessible UIs with a focus on DX and performance.',
      subject: 'Frontend Engineering inquiry',
      size: 'tall',
      featured: true,
      stack: [
        { icon: 'simple-icons:react', label: 'React' },
        { icon: 'simple-icons:vuedotjs', label: 'Vue' },
        { icon: 'simple-icons:astro', label: 'Astro' },
        { icon: 'simple-icons:framer', label: 'Framer' },
        { icon: 'simple-icons:webflow', label: 'Webflow' },
        { icon: 'simple-icons:elementor', label: 'Elementor' },
      ],
    },
    {
      title: 'Mobile Development',
      body: 'Cross-platform apps in React Native shipped to iOS and Android.',
      subject: 'Mobile Development inquiry',
      size: 'small',
    },
    {
      title: 'Mentoring & Curriculum',
      body: 'Teaching developers how to go from zero to production, with real-world projects.',
      subject: 'Mentoring inquiry',
      size: 'small',
    },
  ],
  id: [
    {
      title: 'Full-stack Development',
      body: 'API ter-type dan frontend modern — dari skema hingga rilis.',
      subject: 'Permintaan Full-stack Development',
      size: 'wide',
      stack: [
        { icon: 'simple-icons:laravel', label: 'Laravel' },
        { icon: 'simple-icons:hono', label: 'Hono' },
        { icon: 'simple-icons:postgresql', label: 'PostgreSQL' },
        { icon: 'simple-icons:typescript', label: 'TypeScript' },
        { icon: 'simple-icons:wordpress', label: 'WordPress' },
      ],
    },
    {
      title: 'Frontend Engineering',
      body: 'UI yang akurat dan aksesibel, fokus pada DX dan performa.',
      subject: 'Permintaan Frontend Engineering',
      size: 'tall',
      featured: true,
      stack: [
        { icon: 'simple-icons:react', label: 'React' },
        { icon: 'simple-icons:vuedotjs', label: 'Vue' },
        { icon: 'simple-icons:astro', label: 'Astro' },
        { icon: 'simple-icons:framer', label: 'Framer' },
        { icon: 'simple-icons:webflow', label: 'Webflow' },
        { icon: 'simple-icons:elementor', label: 'Elementor' },
      ],
    },
    {
      title: 'Mobile Development',
      body: 'Aplikasi cross-platform dengan React Native dirilis ke iOS dan Android.',
      subject: 'Permintaan Mobile Development',
      size: 'small',
    },
    {
      title: 'Mentorship & Kurikulum',
      body: 'Mendampingi developer dari nol hingga produksi dengan proyek dunia nyata.',
      subject: 'Permintaan Mentorship',
      size: 'small',
    },
  ],
};

const items = services[lang];
const email = EMAIL;

function layoutClass(size: CardSize): string {
  switch (size) {
    case 'wide':
      return 'md:col-span-2';
    case 'tall':
      return 'md:col-start-3 md:row-span-2';
    case 'small':
    default:
      return '';
  }
}

function minHeightClass(size: CardSize): string {
  return size === 'tall' ? 'min-h-[560px]' : 'min-h-[240px]';
}
---

<section class="mx-auto max-w-6xl px-5 py-16 md:py-24">
  <div class="mb-10 flex flex-col items-start gap-4 md:mb-14 md:flex-row md:items-end md:justify-between">
    <div>
      <Badge variant="outline">{t(lang, 'home.services_eyebrow')}</Badge>
      <h2 class="mt-4 max-w-xl font-display text-4xl leading-tight md:text-5xl">
        {t(lang, 'home.services_title')}
      </h2>
    </div>
    <Button href={`mailto:${email}`} variant="primary">
      {t(lang, 'home.services_cta')}
    </Button>
  </div>

  <div class="grid auto-rows-[minmax(240px,auto)] grid-cols-1 gap-4 md:grid-cols-3 md:gap-5">
    {
      items.map((service) => {
        const isFeatured = service.featured;
        const baseClass = isFeatured
          ? 'bg-(--color-accent) text-(--color-accent-foreground) border border-transparent'
          : 'bg-(--color-bg-secondary) text-(--color-text) border border-(--color-border) hover:bg-(--color-accent) hover:border-(--color-accent)';

        return (
          <a
            href={`mailto:${email}?subject=${encodeURIComponent(service.subject)}`}
            aria-label={service.title}
            class:list={[
              'group relative flex flex-col overflow-hidden rounded-3xl p-8 transition-colors duration-300 ease-out md:p-10',
              layoutClass(service.size),
              minHeightClass(service.size),
              baseClass,
            ]}
          >
            <svg
              aria-hidden="true"
              viewBox="0 0 400 400"
              class:list={[
                'pointer-events-none absolute transition-opacity duration-500 ease-out',
                isFeatured
                  ? 'top-8 -right-16 h-[260px] w-[260px] opacity-25 text-(--color-accent-foreground) md:top-10'
                  : 'top-1/2 -right-16 h-[340px] w-[340px] -translate-y-1/2 opacity-0 group-hover:opacity-20 text-(--color-accent-foreground)',
              ]}
            >
              <circle cx="200" cy="200" r="120" fill="none" stroke="currentColor" stroke-width="1.5" />
              <circle cx="260" cy="200" r="120" fill="none" stroke="currentColor" stroke-width="1.5" />
              <circle cx="230" cy="160" r="120" fill="none" stroke="currentColor" stroke-width="1.5" />
            </svg>

            <span
              class:list={[
                'h-0.5 w-10 transition-colors duration-300 ease-out',
                isFeatured
                  ? 'bg-(--color-accent-foreground)'
                  : 'bg-(--color-text) group-hover:bg-(--color-accent-foreground)',
              ]}
              aria-hidden="true"
            />

            <h3
              class:list={[
                'relative mt-6 font-display leading-tight transition-colors duration-300 ease-out',
                service.size === 'tall' ? 'text-4xl md:text-5xl' : 'text-3xl md:text-4xl',
                isFeatured
                  ? 'text-(--color-accent-foreground)'
                  : 'text-(--color-text) group-hover:text-(--color-accent-foreground)',
              ]}
            >
              {service.title}
            </h3>

            <p
              class:list={[
                'relative mt-4 max-w-md text-sm leading-relaxed transition-colors duration-300 ease-out md:text-base',
                isFeatured
                  ? 'text-(--color-accent-foreground)/80'
                  : 'text-(--color-text-secondary) group-hover:text-(--color-accent-foreground)/80',
              ]}
            >
              {service.body}
            </p>

            {service.stack && (
              <ul class="relative mt-6 flex flex-wrap items-center gap-2">
                {service.stack.map((tech) => (
                  <li
                    class:list={[
                      'inline-flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-xs font-medium transition-colors duration-300 ease-out',
                      isFeatured
                        ? 'border-(--color-accent-foreground)/30 text-(--color-accent-foreground)'
                        : 'border-(--color-border) bg-(--color-bg) text-(--color-text) group-hover:border-(--color-accent-foreground)/30 group-hover:bg-transparent group-hover:text-(--color-accent-foreground)',
                    ]}
                  >
                    <Icon name={tech.icon} class="size-3.5" />
                    <span>{tech.label}</span>
                  </li>
                ))}
              </ul>
            )}

            <span
              class:list={[
                'relative mt-auto flex items-center justify-between pt-8 transition-colors duration-300 ease-out',
                isFeatured
                  ? 'text-(--color-accent-foreground)'
                  : 'text-(--color-text) group-hover:text-(--color-accent-foreground)',
              ]}
            >
              <span class="text-xs font-medium uppercase tracking-[0.18em] opacity-60">
                {service.featured ? 'Featured' : 'Service'}
              </span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class:list={[
                  'transition-transform duration-300 ease-out',
                  service.size === 'tall' ? 'size-8 md:size-10' : 'size-6 md:size-7',
                  isFeatured ? '-rotate-45' : 'group-hover:-rotate-45',
                ]}
                aria-hidden="true"
              >
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </span>
          </a>
        );
      })
    }
  </div>
</section>
