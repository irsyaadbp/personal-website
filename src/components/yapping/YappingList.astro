---
import YappingRow from './YappingRow.astro';
import { yaps } from '../../lib/yapping';
import type { Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
---

<div class="flex flex-col border-t border-(--color-border)">
  {yaps.map((yap) => (
    <YappingRow
      date={yap.date}
      title={yap.title}
      author={yap.author}
      href={yap.href}
      lang={lang}
    />
  ))}
</div>
