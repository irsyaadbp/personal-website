---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import WritingCard from '../../components/writings/WritingCard.astro';
import { t } from '../../i18n';

const lang = 'id' as const;

const allWritings = await getCollection('writings');
const published = allWritings
  .filter((w) => w.data.published)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout title="Tulisan" lang={lang}>
  <section class="mx-auto max-w-6xl px-5 pt-16 pb-12 md:pt-24">
    <h1 class="font-display text-5xl leading-[0.95] md:text-7xl">
      {t(lang, 'writings.title')}
    </h1>
    <p class="mt-4 max-w-2xl text-base text-(--color-text-secondary) md:text-lg">
      {t(lang, 'writings.subtitle')}
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-16 md:pb-24">
    {
      published.length === 0 ? (
        <div class="flex flex-col items-center justify-center rounded-3xl border border-dashed border-(--color-border) bg-(--color-bg-secondary) px-6 py-24 text-center">
          <div class="text-6xl">✍️</div>
          <h2 class="mt-6 font-display text-4xl">{t(lang, 'writings.coming_soon_title')}</h2>
          <p class="mt-3 max-w-md text-(--color-text-secondary)">
            {t(lang, 'writings.coming_soon_body')}
          </p>
        </div>
      ) : (
        <div class="grid gap-5 md:grid-cols-2">
          {published.map((writing) => (
            <WritingCard
              slug={writing.id}
              title={writing.data.title}
              description={writing.data.description}
              date={writing.data.date}
              tags={writing.data.tags}
              heroImage={writing.data.heroImage}
              lang={lang}
            />
          ))}
        </div>
      )
    }
  </section>
</Layout>
