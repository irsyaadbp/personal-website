---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import ProjectGrid from '../../../components/projects/ProjectGrid.astro';
import { t } from '../../../i18n';

const lang = 'id' as const;

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout title="Proyek" lang={lang}>
  <section class="mx-auto max-w-6xl px-5 pt-16 pb-12 md:pt-24">
    <h1 class="font-display text-5xl leading-[0.95] md:text-7xl">
      {t(lang, 'projects.title')}
    </h1>
    <p class="mt-4 max-w-2xl text-base text-(--color-text-secondary) md:text-lg">
      {t(lang, 'projects.subtitle')}
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-16 md:pb-24">
    <ProjectGrid projects={projects} lang={lang} />
  </section>
</Layout>
