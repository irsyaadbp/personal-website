---
import Main from "@/layouts/main.astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import { cn } from "@/lib/utils";
import { ArrowUpRight } from "lucide-react";

export async function getStaticPaths() {
  const posts = await getCollection("projects");

  return posts.map((post) => ({
    params: { id: post.id },
    props: {
      post,
    },
  }));
}

const { post } = Astro.props;
const { Content: Markdown } = await render(post);

const content = {
  title: post.data.title,
  description: post.data.description,
};
---

<Main content={content}>
  <div
    class="min-h-screen py-32 lg:pt-56 container max-w-5xl mx-auto px-4 leading-8"
  >
    <h2 class="text-5xl md:text-6xl lg:text-7xl font-bold mx-auto">
      {content.title}
    </h2>
    <p class="mt-12 text-zinc-500">
      {content.description}
    </p>

    {
      !!post.data.link && (
        <div class="mt-10 flex justify-end">
          <a
            href={post.data.link}
            target="_blank"
            rel="noopener noreferrer"
            class={cn(
              "inline-flex items-center gap-2 text-foreground hover:text-primary transition-colors",
              "underline underline-offset-4 decoration-1 hover:decoration-2",
              "group "
            )}
          >
            <span>View Project</span>
            <ArrowUpRight className="h-4 w-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
          </a>
        </div>
      )
    }
    <hr class="mt-10 mb-12" />
    <div class="grid grid-cols-1 gap-12">
      {
        !!post.data.info && (
          <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
            {post.data.info.map((info) => (
              <div>
                <h3 class="text-base md:text-lg text-zinc-500 font-bold">
                  {info.title}
                </h3>
                <p class="text-lg md:text-2xl font-bold mt-1">
                  {info.description}
                </p>
              </div>
            ))}
          </div>
        )
      }

      <Image
        src={post.data.image}
        alt={`Poster ${content.title}`}
        class="w-full h-auto"
        loading="lazy"
        decoding="async"
        width={1248}
        widths={[380, 720, 1024, 1248]}
        height={832}
        quality={80}
      />

      <Markdown />
    </div>
  </div>
</Main>
