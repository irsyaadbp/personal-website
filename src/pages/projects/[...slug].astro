---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Minimap from '../../components/projects/Minimap.astro';
import NextProject from '../../components/projects/NextProject.astro';
import Badge from '../../components/ui/Badge.astro';
import { sortProjectsByOrder, getNextProject } from '../../lib/projects';
import { getLocalizedPath, t } from '../../i18n';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  const sorted = sortProjectsByOrder(projects);
  return sorted.map((project) => {
    const nextProject = getNextProject(project.id, sorted);
    return {
      params: { slug: project.id },
      props: { project, nextProject },
    };
  });
}

const lang = 'en' as const;
const { project, nextProject } = Astro.props;
const { Content, headings } = await render(project);
const { data } = project;
---

<Layout title={data.title} description={data.description} lang={lang}>
  <section class="mx-auto max-w-6xl px-5 pt-12 pb-8 md:pt-16">
    <a
      href={getLocalizedPath('/projects', lang)}
      class="inline-flex items-center gap-2 text-sm text-(--color-text-secondary) hover:text-(--color-text)"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true">
        <path d="m12 19-7-7 7-7"></path>
        <path d="M19 12H5"></path>
      </svg>
      {t(lang, 'projects.back_to_projects')}
    </a>

    <h1 class="mt-6 font-display text-5xl leading-[0.95] md:text-6xl">{data.title}</h1>
    <p class="mt-5 max-w-3xl text-base text-(--color-text-secondary) md:text-lg">
      {data.description}
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-10">
    <div class="aspect-[16/9] overflow-hidden rounded-3xl bg-(--color-bg-secondary)">
      <img
        src={data.heroImage}
        alt={data.title}
        loading="lazy"
        onerror="this.style.display='none'; this.parentElement.classList.add('image-fallback');"
        class="h-full w-full object-cover"
      />
      <div class="pointer-events-none hidden h-full items-center justify-center text-6xl text-(--color-text-secondary) [.image-fallback_&]:flex">
        ✦
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-16 md:pb-24">
    <div class="grid gap-10 lg:grid-cols-[1fr_220px] lg:gap-16">
      <div>
        <dl class="mb-10 grid gap-6 rounded-3xl border border-(--color-border) bg-(--color-bg-secondary) p-6 sm:grid-cols-2 md:grid-cols-4">
          {data.client && (
            <div>
              <dt class="text-xs uppercase tracking-wider text-(--color-text-muted)">
                {t(lang, 'projects.detail_client')}
              </dt>
              <dd class="mt-2 text-sm font-medium">{data.client}</dd>
            </div>
          )}
          <div>
            <dt class="text-xs uppercase tracking-wider text-(--color-text-muted)">
              {t(lang, 'projects.detail_role')}
            </dt>
            <dd class="mt-2 text-sm font-medium">{data.role}</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wider text-(--color-text-muted)">
              {t(lang, 'projects.detail_year')}
            </dt>
            <dd class="mt-2 text-sm font-medium">{data.year}</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wider text-(--color-text-muted)">
              {t(lang, 'projects.detail_tech')}
            </dt>
            <dd class="mt-2 flex flex-wrap gap-1.5">
              {data.techStack.map((tech) => <Badge variant="muted">{tech}</Badge>)}
            </dd>
          </div>
        </dl>

        <article class="prose-project">
          <Content />
        </article>
      </div>

      <Minimap headings={headings} lang={lang} />
    </div>
  </section>

  {
    nextProject && (
      <section class="mx-auto max-w-6xl px-5 pb-16 md:pb-24">
        <NextProject next={nextProject} lang={lang} />
      </section>
    )
  }
</Layout>

<style is:global>
  .prose-project {
    color: var(--color-text-secondary);
    font-size: 1rem;
    line-height: 1.7;
  }
  .prose-project h2 {
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1.2;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    scroll-margin-top: 6rem;
  }
  .prose-project h3 {
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.3;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    scroll-margin-top: 6rem;
  }
  .prose-project p {
    margin-bottom: 1.25rem;
  }
  .prose-project ul,
  .prose-project ol {
    margin-bottom: 1.25rem;
    padding-left: 1.25rem;
  }
  .prose-project li {
    margin-bottom: 0.5rem;
    list-style-type: disc;
  }
  .prose-project ol li {
    list-style-type: decimal;
  }
  .prose-project a {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose-project strong {
    color: var(--color-text);
    font-weight: 600;
  }
  .prose-project code {
    background-color: var(--color-bg-secondary);
    padding: 0.125rem 0.375rem;
    border-radius: 0.375rem;
    font-size: 0.875em;
  }
  .prose-project hr {
    border-color: var(--color-border);
    margin-top: 2rem;
    margin-bottom: 2rem;
  }
</style>
