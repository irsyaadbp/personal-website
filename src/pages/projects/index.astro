---
import Main from "@/layouts/main.astro";
import { getCollection } from "astro:content";
import { BentoCard, BentoGrid } from "@/components/magicui/bento-grid";

const content = {
  title: "Projects",
};

const projects = await getCollection("projects");

const allProjects: any[] = projects.map((pro) => ({
  name: pro.data.title,
  description: pro.data.short_description || pro.data.description,
  background: pro.data.image,
  // link: pro.data.link,
  href: `/projects/${pro.id}`,
  cta: "View detail",
  className: "lg:col-span-1",
}));
---

<Main
  content={content}
  style={{ backgroundImage: "url('/assets/images/projects/line.svg')" }}
>
  <div class="min-h-screen pt-40 container mx-auto px-4">
    <div class="max-w-7xl mx-auto">
      <BentoGrid>
        {
          allProjects.map((feature, idx) => (
            <BentoCard key={idx} {...feature} role="button" client:load />
          ))
        }
      </BentoGrid>
    </div>
  </div>
</Main>
