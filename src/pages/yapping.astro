---
import Layout from '../layouts/Layout.astro';
import YappingList from '../components/yapping/YappingList.astro';
import { t } from '../i18n';

const lang = 'en' as const;
---

<Layout title="Yapping" lang={lang}>
  <section class="mx-auto max-w-6xl px-5 pt-16 pb-12 md:pt-24">
    <h1 class="font-display text-5xl leading-[0.95] md:text-7xl">
      {t(lang, 'yapping.title')}
    </h1>
    <p class="mt-4 max-w-2xl text-base text-(--color-text-secondary) md:text-lg">
      {t(lang, 'yapping.subtitle')}
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-16 md:pb-24">
    <YappingList lang={lang} />
  </section>
</Layout>
